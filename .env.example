# HTTP server
PORT=3000

# PostgreSQL connection string (never commit a real .env file)
DATABASE_URL=postgres://user:password@localhost:5432/background_job_system

# --- Worker / job system configuration ---

# How many jobs the worker may process concurrently
WORKER_CONCURRENCY=3

# Baseline artificial processing delay (ms) for review-analysis jobs;
# testProcessingDelayMs on a job overrides this for controlled break-testing
WORKER_TASK_DELAY_MS=2500

# --- DeepSeek (real review analysis) ---

# API key for the DeepSeek API. Required for normal (real) review-analysis.
# Never commit a real key; leave this blank in shared files.
DEEPSEEK_API_KEY=

# Model used for review analysis. DeepSeek's current model is deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash

# Provider request timeout in milliseconds; the worker must not hang forever.
DEEPSEEK_TIMEOUT_MS=60000

# Maximum number of attempts a job gets before it is moved to "dead"
JOB_MAX_ATTEMPTS=5

# Base delay for exponential retry backoff (ms):
#   retryDelay = base * 2^(attempt-1) + jitter(0..base)
JOB_BASE_DELAY_MS=1000

# How long a "processing" job may run before the worker's stuck-job sweeper
# recovers it (back to pending, or to dead when attempts are exhausted)
JOB_STUCK_TIMEOUT_MS=60000

# How often the worker polls the database for eligible jobs (ms)
WORKER_POLL_INTERVAL_MS=1000