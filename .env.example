# HTTP server
PORT=3000

# PostgreSQL connection string (never commit a real .env file)
DATABASE_URL=postgres://user:password@localhost:5432/background_job_system

# --- Worker / job system configuration ---

# How many jobs the worker may process concurrently
WORKER_CONCURRENCY=3

# Simulated review-analysis work duration (ms); used in place of a real AI call
WORKER_TASK_DELAY_MS=2500

# Maximum number of attempts a job gets before it is moved to "dead"
JOB_MAX_ATTEMPTS=5

# Base delay for exponential retry backoff (ms):
#   retryDelay = base * 2^(attempt-1) + jitter(0..base)
JOB_BASE_DELAY_MS=1000

# How long a "processing" job may run before the worker considers it stuck
JOB_STUCK_TIMEOUT_MS=60000

# How often the worker polls the database for eligible jobs (ms)
WORKER_POLL_INTERVAL_MS=1000